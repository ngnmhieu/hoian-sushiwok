---
interface Props {
  href: string;
  /** solid = Handlung, ghost = auf dunklem Grund, outline = auf hellem Grund */
  variant?: 'solid' | 'ghost' | 'outline';
  class?: string;
  rel?: string;
  target?: string;
}

const { href, variant = 'solid', class: extra = '', ...rest } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full border px-6 py-4 text-label font-medium tracking-[0.08em] uppercase no-underline transition duration-200 hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0';

const variants = {
  solid: 'border-transparent bg-lantern text-white hover:bg-[#c93d21]',
  ghost: 'border-current text-cream hover:bg-cream/10',
  outline: 'border-night/20 text-night hover:bg-night/5',
};
---

<a href={href} class={`${base} ${variants[variant]} ${extra}`} {...rest}><slot /></a>
