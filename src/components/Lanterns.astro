---
// Seidenlaternen über dem Fluss — das Bild, für das Hội An bekannt ist.
// Reines CSS, kein Bild, kein JavaScript.
const lanterns = [
  { drop: '3rem', size: '2.1rem', hue: 'var(--lantern)', delay: '0s' },
  { drop: '6.5rem', size: '2.8rem', hue: 'var(--wall)', delay: '-2.4s' },
  { drop: '2rem', size: '1.7rem', hue: 'var(--lantern-soft)', delay: '-4.1s' },
  { drop: '8rem', size: '3.2rem', hue: 'var(--lantern)', delay: '-1.2s' },
  { drop: '4rem', size: '2.2rem', hue: 'var(--wall)', delay: '-5.6s' },
  { drop: '6rem', size: '1.9rem', hue: 'var(--lantern-soft)', delay: '-3.3s' },
  { drop: '2.5rem', size: '2.6rem', hue: 'var(--lantern)', delay: '-6.8s' },
];
---

<div class="lanterns" aria-hidden="true">
  {
    lanterns.map((l, i) => (
      <div
        class="lantern"
        style={`--drop:${l.drop};--size:${l.size};--hue:${l.hue};--delay:${l.delay};animation-delay:${l.delay}, ${i * 0.12}s`}
      >
        <span class="lantern__cord"></span>
        <span class="lantern__body"></span>
        <span class="lantern__tassel"></span>
      </div>
    ))
  }
</div>
