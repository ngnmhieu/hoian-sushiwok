---
import { site } from '../data/site';

const link = 'border-b border-cream/15 no-underline transition-colors hover:border-lantern hover:text-cream';
---

<!-- Adresse, Telefon und Öffnungszeiten standen hier ein zweites Mal. Sie
     stehen im Kontaktabschnitt der Startseite; übrig bleibt das Pflichtteil. -->
<footer class="border-t border-cream/15 bg-ink-900 py-8 text-label text-cream-dim">
  <div class="mx-auto flex w-full max-w-shell flex-wrap justify-between gap-x-5 gap-y-3 px-gutter">
    <span>&copy; {new Date().getFullYear()} {site.name}</span>
    <span>
      <a class={link} href="/impressum/">Impressum</a> &nbsp;·&nbsp;
      <a class={link} href="/datenschutz/">Datenschutz</a>
    </span>
  </div>
</footer>
