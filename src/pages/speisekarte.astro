---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import cover from '../assets/speisekarte-titel.jpg';

// Die gedruckte Karte liegt als PDF in public/. Kein Trailing Slash: das hier
// ist eine Datei, keine Route — mit Slash antwortet Pages mit 404.
const pdf = '/speisekarte.pdf';
---

<Base
  title="Speisekarte"
  description="Die ganze Karte: Sushi und warme Gerichte — HOIAN WOK & SUSHI in Löbau."
>
  <section class="pt-[clamp(2rem,4.5vw,4rem)] pb-band">
    <div class="mx-auto w-full max-w-shell px-gutter">
      <h1 class="max-w-[16ch] font-display text-heading leading-none tracking-[-0.015em] text-balance">
        Speisekarte
      </h1>
      <p class="mt-6 max-w-[62ch] text-pretty">
        Hier finden Sie unsere komplette Speisekarte mit allen Preisen. Alle Speisen gibt es auch
        zum Mitnehmen.
      </p>

      <p class="mt-10">
        <Button href={pdf} target="_blank" rel="noopener">Speisekarte als PDF öffnen</Button>
      </p>

      <!-- Auf dem Handy zeigt weder Chrome noch Safari ein eingebettetes PDF
           zuverlässig an — mal bleibt der Rahmen leer, mal steht nur Seite 1
           ohne Scrollen darin. Dort führt deshalb die Titelseite in den
           nativen Viewer, der auch zoomen kann. Ab md steht der Rahmen. -->
      <a
        href={pdf}
        target="_blank"
        rel="noopener"
        class="group mt-6 block border border-night/15 no-underline md:hidden"
      >
        <Image
          src={cover}
          alt="Titelseite der Speisekarte"
          widths={[480, 760, 1240]}
          sizes="100vw"
          loading="eager"
          class="w-full"
        />
        <span
          class="flex items-center justify-between gap-3 border-t border-night/15 bg-paper-deep/55 px-4 py-3.5 text-label font-medium tracking-[0.08em] text-night uppercase"
        >
          Speisekarte öffnen
          <svg
            class="size-4 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 12h15M13 6l6 6-6 6" />
          </svg>
        </span>
      </a>
      <iframe
        src={pdf}
        title="Speisekarte als PDF"
        class="mt-6 hidden h-[min(85vh,60rem)] w-full border border-night/15 md:block"></iframe>
    </div>
  </section>
</Base>
