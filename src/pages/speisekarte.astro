---
import Base from '../layouts/Base.astro';
import MenuExplorer from '../components/MenuExplorer.tsx';
import Eyebrow from '../components/Eyebrow.astro';
import { isDraft } from '../data/site';
---

<Base
  title="Speisekarte"
  description="Die ganze Karte: Sushi von der kalten Theke und Gerichte aus dem heißen Wok."
>
  <section class="py-band">
    <div class="mx-auto w-full max-w-shell px-gutter">
      <Eyebrow>Speisekarte</Eyebrow>
      <h1 class="max-w-[16ch] font-display wonk text-heading leading-none tracking-[-0.015em] text-balance">
        Die ganze Karte
      </h1>
      <p class="mt-6 max-w-[52ch] text-lead leading-[1.55] text-pretty">
        Kalte Theke und heißer Wok stehen nebeneinander. Filtern Sie auf eine Hälfte, wenn Sie schon
        wissen, worauf Sie Lust haben.
      </p>
      <hr class="my-10 border-t border-night/15" />
      {
        isDraft && (
          <p class="mb-10 border-l-[3px] border-lantern bg-lantern/8 px-5 py-4 text-label">
            <strong class="font-semibold">Platzhalter-Karte.</strong> Gerichte und Preise werden noch
            eingetragen. Die Inhalte stehen in <code>src/data/menu.ts</code>.
          </p>
        )
      }
      <MenuExplorer client:load />
    </div>
  </section>
</Base>
