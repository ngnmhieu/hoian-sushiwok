---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Hours from '../components/Hours.astro';
import { contact } from '../data/site';
---

<Base
  title="Kontakt"
  description="Adresse, Öffnungszeiten und Telefonnummer für Reservierungen bei Hội An Sushi & Wok."
>
  <section class="py-band">
    <div class="mx-auto w-full max-w-shell px-gutter">
      <Eyebrow>Kontakt</Eyebrow>
      <h1 class="max-w-[16ch] font-display wonk text-heading leading-none tracking-[-0.015em] text-balance">
        Reservieren, abholen, vorbeikommen
      </h1>
      <hr class="my-10 border-t border-night/15" />
      <div class="grid gap-[clamp(2rem,5vw,4.5rem)] md:grid-cols-2">
        <div>
          <h2 class="font-display wonk text-title leading-none text-balance">Adresse</h2>
          <p class="mt-4 text-lead leading-[1.5] text-pretty">
            {contact.street}<br />
            {contact.postalCode} {contact.city}
          </p>
          <h2 class="mt-10 font-display wonk text-title leading-none text-balance">Telefon &amp; E-Mail</h2>
          <p class="mt-4">
            <a class="underline decoration-night/30 underline-offset-4 hover:decoration-lantern" href={contact.phoneHref}>{contact.phone}</a><br />
            <a class="underline decoration-night/30 underline-offset-4 hover:decoration-lantern" href={`mailto:${contact.email}`}>{contact.email}</a>
          </p>
          <p class="mt-8 flex flex-wrap gap-3">
            <Button href={contact.phoneHref}>Anrufen</Button>
            {
              contact.mapsUrl && (
                <Button href={contact.mapsUrl} variant="outline" rel="noopener" target="_blank">
                  Route öffnen
                </Button>
              )
            }
          </p>
        </div>
        <div>
          <h2 class="font-display wonk text-title leading-none text-balance">Öffnungszeiten</h2>
          <Hours class="mt-4" />
          <p class="mt-6 text-label text-night-dim">
            An Feiertagen können die Zeiten abweichen. Rufen Sie im Zweifel kurz an.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
