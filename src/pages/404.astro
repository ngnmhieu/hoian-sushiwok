---
import Base from '../layouts/Base.astro';
import Lanterns from '../components/Lanterns.astro';
import Button from '../components/Button.astro';
---

<Base title="Seite nicht gefunden" description="Diese Seite gibt es nicht.">
  <section
    class="relative overflow-hidden bg-[radial-gradient(120%_90%_at_50%_-10%,var(--color-ink-700),var(--color-ink-900)_62%)] py-[clamp(6rem,16vh,10rem)] text-cream"
  >
    <Lanterns />
    <div class="relative z-20 mx-auto w-full max-w-shell px-gutter text-center">
      <h1 class="font-display wonk text-heading leading-none tracking-[-0.015em] text-balance">
        Hier ist nichts serviert
      </h1>
      <p class="mx-auto mt-7 mb-10 max-w-[44ch] text-lead leading-[1.5] text-pretty text-cream-dim">
        Die Seite gibt es nicht — oder nicht mehr.
      </p>
      <div class="flex flex-wrap justify-center gap-3.5">
        <Button href="/">Zur Startseite</Button>
        <Button href="/speisekarte/" variant="ghost">Zur Speisekarte</Button>
      </div>
    </div>
  </section>
</Base>
