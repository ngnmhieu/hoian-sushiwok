---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Hours from '../components/Hours.astro';
import { contact, site } from '../data/site';
import hero from '../assets/hoian-1.jpg';
import logo from '../assets/hoianlogo-transparent.png';
import restaurant1 from '../assets/restaurant-1.jpeg';
import restaurant2 from '../assets/restaurant-2.jpeg';
import nigiri from '../assets/nigiri-chopstick-2.png';
import wok from '../assets/wok-1.jpg';
import sushi1 from '../assets/sushi-plate-1.jpg';
import sushi2 from '../assets/sushi-plate-2.jpg';
import sushi3 from '../assets/sushi-plate-3.jpg';
import sushi4 from '../assets/sushi-plate-4.jpg';

// Vier Aufnahmen als Quadrate. Den Zuschnitt macht object-cover im quadratischen
// Rahmen; der Rahmen schneidet auch die Vergrößerung beim Hovern ab.
const plates = [
  { src: sushi1, alt: 'Inside-Out-Rolle mit Lachs und Soße auf Schieferplatte' },
  { src: sushi2, alt: 'Nigiri mit Lachs, eines davon zwischen Stäbchen' },
  { src: sushi3, alt: 'Maki mit Lachs, dazu Wasabi und eingelegter Ingwer' },
  { src: sushi4, alt: 'Zwei Lachs-Nigiri auf einem weißen Teller' },
];

// Zwei Aufnahmen aus dem Gastraum. Beide sind hochkant, deshalb derselbe
// Zuschnitt für beide — sonst stünden zwei verschiedene Höhen nebeneinander.
const shot = 'aspect-4/5 w-full object-cover';

const rise = 'opacity-0 animate-rise motion-reduce:animate-none motion-reduce:opacity-100';
const mapsQuery = encodeURIComponent(
  `${contact.street}, ${contact.postalCode} ${contact.city}`
);
const mapsEmbed = `https://www.google.com/maps?q=${mapsQuery}&z=16&hl=de&output=embed`;
const darkLink =
  'underline decoration-cream/30 underline-offset-4 hover:decoration-lantern-soft';
---

<Base
  overHero
  standaloneTitle
  title="HOIAN - WOK & SUSHI Löbau"
  description="Sushi und warme Gerichte — asiatisch essen mitten in Löbau"
>
  <section
    class="relative overflow-hidden bg-[radial-gradient(120%_90%_at_50%_-10%,var(--color-ink-700),var(--color-ink-900)_62%)] pt-[calc(4.25rem+clamp(3rem,8vh,5rem))] pb-[clamp(4rem,10vh,7rem)] text-cream"
  >
    <!-- Die Laternen von Hoi An als Foto statt als CSS-Nachbau. Der Verlauf
         darüber hält die hellen Laternen von der Schrift fern. -->
    <Image
      src={hero}
      alt=""
      width={2560}
      height={1707}
      widths={[960, 1440, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0 bg-linear-to-b from-ink-900/88 via-ink-900/75 to-ink-900/92"
    >
    </div>
    <div class="relative z-20 mx-auto w-full max-w-shell px-gutter text-center">
      <h1 class={`flex justify-center ${rise}`} style="animation-delay:.15s">
        <Image
          src={logo}
          alt={site.name}
          width={280}
          height={280}
          class="w-[clamp(9rem,22vw,16rem)] h-auto"
        />
      </h1>
      <p
        class={`mx-auto mt-7 mb-10 max-w-[44ch] text-lead leading-[1.5] text-pretty text-cream ${rise}`}
        style="animation-delay:.35s"
      >
        Asiatisch essen mitten in Löbau
      </p>
      <div class={`flex flex-wrap justify-center gap-3.5 ${rise}`} style="animation-delay:.5s">
        <Button href="/speisekarte/">Speisekarte ansehen</Button>
        <Button href="#kontakt" variant="ghost">Tisch reservieren</Button>
      </div>
    </div>
  </section>

  <section class="bg-paper py-[clamp(2rem,4.5vw,4rem)]">
    <div class="mx-auto w-full max-w-shell px-gutter">
      <!-- Die Überschrift stand in einer halben Rasterspalte und brach dort um,
           obwohl der Abschnitt breit genug ist. Sie läuft jetzt über die ganze
           Breite, der Absatz darunter bleibt bei 62 Zeichen. -->
      <h2 class="text-left font-display text-heading leading-none tracking-[-0.015em] text-balance">
        Ein Stück Hoi An in Löbau
      </h2>
      <p class="mt-6 text-lead leading-[1.55] text-pretty">
        Hoi An ist eine Hafenstadt in Zentralvietnam: Laternen über der Altstadt, offene
        Küchen in den Gassen. Die Stadt lässt sich nicht mitbringen, ihre Küche schon — dieselben
        Gewürze, derselbe Reis, dieselben langen Abende, an denen das Essen in die Mitte des
        Tisches kommt und alle zugreifen. Genau das steht hier an der Bahnhofstraße: ein
        asiatisches Restaurant in Löbau mit Wok-Küche und Sushi, gedacht für einen normalen
        Abend in der Stadt, nicht für eine Reise.
      </p>

      <div class="mt-[clamp(2rem,5vw,3.5rem)] grid gap-[clamp(0.75rem,2vw,1.5rem)] sm:grid-cols-2">
        <Image
          src={restaurant1}
          alt="Gastraum mit geschwungener Holzskulptur über der Theke"
          width={1200}
          height={1600}
          widths={[480, 760, 1200]}
          sizes="(min-width: 40rem) 50vw, 100vw"
          class={shot}
        />
        <Image
          src={restaurant2}
          alt="Wandbild mit dem Schriftzug des Restaurants über den Sitzplätzen"
          width={1200}
          height={1600}
          widths={[480, 760, 1200]}
          sizes="(min-width: 40rem) 50vw, 100vw"
          class={shot}
        />
      </div>
    </div>
  </section>

  <section class="bg-ink-900 py-[clamp(2rem,4.5vw,4rem)] text-cream">
    <div
      class="mx-auto grid w-full max-w-shell items-center gap-[clamp(1.5rem,4vw,3rem)] px-gutter md:grid-cols-2"
    >
      <Image
        src={wok}
        alt="Flambierender Wok über offener Flamme in der Küche"
        width={1200}
        height={1500}
        widths={[480, 760, 1200]}
        sizes="(min-width: 48rem) 50vw, 100vw"
        class="aspect-4/5 w-full object-cover"
      />
      <div>
        <h2
          class="pb-6 text-left font-display text-heading leading-none tracking-[-0.015em] text-balance"
        >
          Wok
        </h2>
        <p class="text-lead leading-[1.55] text-pretty">
          Aus dem Wok kommen Bratnudeln, Bratreis und Gebratenes mit Gemüse, dazu Huhn, Ente, Rind,
          Garnelen oder Tofu. Bei voller Hitze ist ein Gericht in wenigen Minuten fertig und steht
          heiß auf dem Tisch. Die Soße wählen Sie dazu: süß-sauer, pikant, Curry oder Erdnuss.
        </p>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-paper py-[clamp(2rem,4.5vw,4rem)] max-sm:pt-20">
    <!-- Freigestelltes Nigiri als Schmuck in der oberen rechten Ecke. Es ragt
         ein Stück über den Rand hinaus, deshalb overflow-hidden am Abschnitt.
         Der Absatz bekommt rechts Platz, damit keine Zeile darunter läuft. -->
    <Image
      src={nigiri}
      alt=""
      width={680}
      height={485}
      widths={[340, 680]}
      sizes="(min-width: 48rem) 20vw, 40vw"
      class="pointer-events-none absolute top-0 right-[clamp(1rem,3vw,2.5rem)] w-[clamp(10rem,28vw,24rem)] -translate-y-[10%] select-none"
    />
    <div class="relative mx-auto w-full max-w-shell px-gutter">
      <h2
        class="pb-6 text-left font-display text-heading leading-none tracking-[-0.015em] text-balance"
      >
        Sushi
      </h2>
      <p class="text-lead leading-[1.55] text-pretty sm:pr-[clamp(11rem,30vw,25rem)]">
        An der Theke wird roher Fisch geschnitten und der Reis von Hand geformt. Was dort entsteht,
        braucht keinen Herd: kalt angerichtet, frisch gerollt und erst dann zusammengestellt, wenn
        die Bestellung da ist. Dazu kalte Vorspeisen.
      </p>

      <ul class="mt-10 grid grid-cols-2 gap-[clamp(0.75rem,2vw,1.5rem)] sm:grid-cols-4">
        {
          plates.map((plate) => (
            <li class="aspect-square overflow-hidden">
              <Image
                src={plate.src}
                alt={plate.alt}
                width={640}
                widths={[320, 480, 640]}
                sizes="(min-width: 40rem) 25vw, 50vw"
                class="h-full w-full object-cover transition-transform duration-300 hover:scale-110 motion-reduce:transition-none motion-reduce:hover:scale-100"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Der Kontakt hat keine eigene Seite mehr, er ist dieser Abschnitt. Das
       Kopfmenü springt mit /#kontakt hierher; scroll-mt hält die Überschrift
       unter der klebenden Kopfzeile frei. -->
  <section id="kontakt" class="scroll-mt-17 bg-ink-900 py-[clamp(2rem,4.5vw,4rem)] text-cream">
    <div class="mx-auto w-full max-w-shell px-gutter">
      <h2 class="text-left font-display text-heading leading-none tracking-[-0.015em] text-balance pb-6">
        Kontakt
      </h2>
      <div class="mt-8 grid gap-[clamp(1.5rem,4vw,3rem)] md:grid-cols-2">
        <div>
          <h3 class="font-display text-title leading-none text-balance">Öffnungszeiten</h3>
          <Hours tone="dark" class="mt-4" />
          <h3 class="mt-10 font-display text-title leading-none text-balance">Telefon</h3>
          <p class="mt-4">
            <a class={darkLink} href={contact.phoneHref}>{contact.phone}</a> /
            <a class={darkLink} href={contact.mobileHref}>{contact.mobile}</a>
          </p>
          <h3 class="mt-10 font-display text-title leading-none text-balance">Reservierung</h3>
          <p class="mt-4 max-w-[46ch]">
            Reservieren können Sie zurzeit nur telefonisch, unter beiden Nummern.
          </p>
          <p class="mt-6">
            <Button href={contact.phoneHref}>Anrufen</Button>
          </p>
        </div>
        <div>
          <h3 class="font-display text-title leading-none text-balance">Adresse</h3>
          <p class="mt-4 text-lead leading-[1.5] text-pretty">{contact.street}<br />{contact.postalCode} {contact.city}</p>
          <iframe
            src={mapsEmbed}
            title={`Karte: ${contact.street}, ${contact.postalCode} ${contact.city}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="mt-6 h-[clamp(14rem,28vw,20rem)] w-full border border-cream/15"></iframe>
          {
            contact.mapsUrl && (
              <p class="mt-6">
                <Button href={contact.mapsUrl} variant="ghost" rel="noopener" target="_blank">
                  Route öffnen
                </Button>
              </p>
            )
          }
        </div>
      </div>
    </div>
  </section>
</Base>
