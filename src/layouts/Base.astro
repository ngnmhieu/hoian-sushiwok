---
import Nav from '../components/Nav.tsx';
import Footer from '../components/Footer.astro';
import { contact, hours, isDraft, site } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site ?? site.url).href;

// Suchmaschinen lesen das als Tatsache. Adresse, Zeiten und Telefon sind echt,
// hängen aber weiter an `isDraft` — der Haken sind jetzt die ungeprüften
// Rechtstexte und die fehlende Speisekarte, nicht mehr fehlende Angaben.
// `openingHours` braucht die Form "Mo-Fr 11:30-14:30" — dafür steht `schema`
// an den Zeiten, die Anzeige in `Hours.astro` bleibt davon unberührt.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: site.name,
  description: site.tagline,
  url: site.url,
  servesCuisine: ['Vietnamesisch', 'Japanisch', 'Sushi'],
  ...(isDraft
    ? {}
    : {
        telephone: contact.phoneHref.replace('tel:', ''),
        address: {
          '@type': 'PostalAddress',
          streetAddress: contact.street,
          postalCode: contact.postalCode,
          addressLocality: contact.city,
          addressCountry: 'DE',
        },
        openingHours: hours.flatMap((h) => h.schema ?? []),
      }),
};
---

<!doctype html>
<html lang="de" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_DE" />
    <meta name="theme-color" content="#0a1412" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <noscript>
      <style>
        /* Ohne JavaScript bleibt die Navigation aufgeklappt statt unerreichbar. */
        @media (max-width: 48rem) {
          [data-nav] {
            display: flex !important;
          }
          [data-nav-toggle] {
            display: none !important;
          }
        }
      </style>
    </noscript>
  </head>
  <body class="bg-paper font-sans text-body leading-[1.65] font-light text-night antialiased">
    <a
      class="absolute top-0 left-2 z-100 -translate-y-24 rounded-full bg-paper px-4 py-2.5 text-night no-underline transition-transform focus:translate-y-2"
      href="#inhalt">Zum Inhalt springen</a
    >
    <header
      class="sticky top-0 z-50 border-b border-cream/15 bg-ink-900/90 text-cream backdrop-blur-md"
    >
      <div
        class="mx-auto flex min-h-17 w-full max-w-shell items-center justify-between gap-4 px-gutter"
      >
        <a
          class="font-display text-[1.15rem] font-semibold tracking-[0.02em] whitespace-nowrap text-red-600 no-underline"
          href="/">Hoi An <span class="text-white">Wok &amp; Sushi</span></a
        >
        <Nav client:load pathname={pathname} />
      </div>
    </header>
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
  </body>
</html>
